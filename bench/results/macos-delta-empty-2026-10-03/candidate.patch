 impl ClientPaneGrid {
+    fn evict_overwritten_metadata(&mut self, start: usize, end: usize) {
+        // Most terminal output has neither OSC 8 links nor combining extras.
+        // An empty HashMap can retain its allocation after earlier content;
+        // avoid hashing every overwritten cell just to discover no entries.
+        if !self.hyperlink_cell_map.is_empty() {
+            for idx in start..end {
+                self.hyperlink_cell_map.remove(&(idx as u32));
+            }
+        }
+        if !self.grapheme_map.is_empty() {
+            let history_base = self.scrollback.len() * self.cols as usize;
+            for idx in start..end {
+                self.grapheme_map.remove(&((history_base + idx) as u32));
+            }
+        }
+    }
