+    /// Scroll the entire screen by one row without recomputing the bottom index.
+    /// Keep this separate so region scrolling does not inherit its register spills.
+    #[inline(never)]
+    pub(crate) fn scroll_up_full_one<D>(&mut self)
+    where
+        T: ResetDiscriminant<D>,
+        D: PartialEq,
+    {
+        if self.display_offset != 0 {
+            self.display_offset = min(self.display_offset + 1, self.max_scroll_limit);
+        }
+
+        if self.history_size() < self.max_scroll_limit {
+            self.raw.initialize(1, self.columns);
+        } else {
+            self.scrolled_past_limit = self.scrolled_past_limit.saturating_add(1);
+        }
+
+        self.raw.rotate_up_one().reset(&self.cursor.template);
+    }
