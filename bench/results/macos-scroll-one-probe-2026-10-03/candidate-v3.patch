+    /// Rotate up by one row and return the newly exposed bottom row.
+    ///
+    /// `zero` already denotes the bottommost visible row. Returning it directly
+    /// avoids recomputing its logical index after a full-screen linefeed.
+    #[inline]
+    pub(super) fn rotate_up_one(&mut self) -> &mut Row<T> {
+        self.zero = if self.zero == 0 { self.inner.len() - 1 } else { self.zero - 1 };
+        &mut self.inner[self.zero]
+    }
