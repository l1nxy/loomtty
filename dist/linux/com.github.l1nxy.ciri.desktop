[Desktop Entry]
Version=1.0
Name=Ciri
Type=Application
Comment=GPU-accelerated terminal multiplexer
TryExec=ciri
Exec=ciri
Icon=com.github.l1nxy.ciri
Categories=System;TerminalEmulator;
Keywords=terminal;tty;pty;multiplexer;
StartupNotify=true
Terminal=false
Actions=new-session;

[Desktop Action new-session]
Name=New Session
Exec=ciri new
