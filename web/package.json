{
  "name": "ciri-web",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-facing renderer + codec for ciritty",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen:constants": "cd .. && cargo run -p ciri-protocol --example dump_constants > web/packages/ciri-codec/src/constants.ts",
    "gen:fixtures": "cd .. && cargo run -p ciri-protocol --example sm_fixtures > web/packages/ciri-codec/src/__fixtures__/sm.json",
    "gen": "npm run gen:constants && npm run gen:fixtures",
    "test": "npm -ws --if-present run test",
    "build": "npm -ws --if-present run build",
    "lint": "npm -ws --if-present run lint"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
